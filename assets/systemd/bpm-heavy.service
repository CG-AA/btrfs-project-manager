[Unit]
Description=bpm: adopt, convert, collapse and recompress projects (one operation per run)
Documentation=man:bpm(1) https://github.com/
After=local-fs.target time-sync.target
ConditionPathExists=@CFG@

[Service]
Type=oneshot
ExecStart=@BIN@ --no-sudo --config @CFG@ tick --heavy-only
SyslogIdentifier=bpm-heavy
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=6h
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@RW@
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
